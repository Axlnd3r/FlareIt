# FlareIt Backend Environment Variables
# Copy this file to .env and fill in values after deploying contracts

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Blockchain ───────────────────────────────────────────────────────────────
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# ─── Contract Addresses (fill after deploying via forge script) ───────────────
SEND_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RATE_READER_ADDRESS=0x0000000000000000000000000000000000000000
MERCHANT_PAYMENT_ADDRESS=0x0000000000000000000000000000000000000000
FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7
ASSET_MANAGER_FXRP_ADDRESS=0xc1Ca88b937d0b528842F95d5731ffB586f4fbDFA
FTSO_V2_ADDRESS=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d
INDEXER_START_BLOCK=0
INDEXER_BLOCK_CHUNK=2000

# ─── Rate Cache ───────────────────────────────────────────────────────────────
RATE_REFRESH_INTERVAL_MS=30000
IDR_REFRESH_INTERVAL_MS=60000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./flareit.db

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EXPLORER_API_URL=https://coston2-explorer.flare.network/api
QUOTE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional: required only for in-app Xaman signing of XRPL direct mint payments
XAMAN_API_KEY=
XAMAN_API_SECRET=
