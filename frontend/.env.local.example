# FlareIt Frontend — Environment Variables
# Copy ini ke frontend/.env.local dan isi setelah deploy contracts

# ─── Backend URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ─── Contract Addresses (NEXT_PUBLIC_ prefix = exposed to browser) ────────────
# Isi setelah forge script deploy — salin dari output Deploy.s.sol
NEXT_PUBLIC_FXRP_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RATE_READER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEND_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Network ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_EXPLORER_URL=https://coston2-explorer.flare.network
